global ColorWhite as TColor
global ColorBlack as TColor
global ColorSelected as TColor
global ColorFilterBack as TColor
global ColorFilterFront as TColor
global ColorFilterOverlay as TColor
global ColorFilterSelected as TColor

global ColorPlayer as TColor
global ColorEnemy as TColor
global ColorNeutral as TColor

//--------------------------------------------------------------
//
//--------------------------------------------------------------

ColorSet(ColorWhite,255,255,255,255)
ColorSet(ColorBlack,0,0,0,255)

ColorSet(ColorSelected,255,200,50,255)
ColorSet(ColorFilterBack,0,155,0,255)
ColorSet(ColorFilterFront,255,255,255,255)
ColorSet(ColorFilterOverlay,255,255,255,255)
ColorSet(ColorFilterSelected,55,255,55,255)

ColorSet(ColorPlayer,0,127,255,255)
ColorSet(ColorEnemy,255,0,127,255)
ColorSet(ColorNeutral,255,255,200,255)

